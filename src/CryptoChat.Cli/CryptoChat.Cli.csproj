<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CryptoChat</AssemblyName>
    <RootNamespace>CryptoChat.Cli</RootNamespace>
    <Version>0.1.0</Version>
    <InformationalVersion>0.1a</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CryptoChat.Core\CryptoChat.Core.csproj" />
  </ItemGroup>

  <!-- Каталог content/ из корня репозитория копируется рядом с программой -->
  <ItemGroup>
    <Content Include="..\..\content\**\*.json" Link="content\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
