<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CryptoChat</AssemblyName>
    <RootNamespace>CryptoChat.Cli</RootNamespace>
    <Version>0.2.5</Version>
    <InformationalVersion>0.2.5a</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CryptoChat.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- База бесед SQLite (logs/cryptochat.db) и отчёт по ключу stats -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <!-- Отправка журналов на почту: SMTP с SSL (порт 465) и STARTTLS (порт 587) -->
    <PackageReference Include="MailKit" Version="4.18.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CryptoChat.Core\CryptoChat.Core.csproj" />
  </ItemGroup>

  <!-- Каталог content/ из корня репозитория копируется рядом с программой -->
  <ItemGroup>
    <Content Include="..\..\content\**\*.json" Link="content\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Словари морфологии (pymorphy3) копируются рядом с программой -->
  <ItemGroup>
    <None Include="..\..\dicts\**\*" Link="dicts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
